{
  "id": "/",
  "name": "Name Tap — local phrase alerts",
  "short_name": "Name Tap",
  "description": "Feel a vibration when local captions match your chosen phrase.",
  "start_url": "/?source=pwa&v=__BUILD_VERSION__",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F4F0E6",
  "theme_color": "#C9FF38",
  "categories": ["accessibility", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Choose phrases", "short_name": "Add phrase", "url": "/#setup", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Try sample data", "short_name": "Demo", "url": "/?demo=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
